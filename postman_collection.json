          }
        },
        {
          "name": "Get Category by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sweet Desserts & Shakes\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "{{categoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Menu Items",
      "item": [
        {
          "name": "List Menu Items (Filter & Search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu?search=Burger&minPrice=500&maxPrice=1200",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "menu"],
              "query": [
                { "key": "search", "value": "Burger" },
                { "key": "minPrice", "value": "500" },
                { "key": "maxPrice", "value": "1200" }
              ]
            }
          }
        },
        {
          "name": "Create Menu Item (Restaurant Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"{{categoryId}}\",\n  \"name\": \"Zinger Burger Deluxe\",\n  \"description\": \"Crispy fried chicken thigh with spicy mayo\",\n  \"price\": 650,\n  \"discountPrice\": 599,\n  \"ingredients\": [\"Chicken\", \"Lettuce\", \"Cheese\", \"Sauce\"],\n  \"preparationTime\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "menu"]
            }
          }
        },
        {
          "name": "Get Menu Item By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu/{{menuItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "{{menuItemId}}"]
            }
          }
        },
        {
          "name": "Update Menu Item",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 699,\n  \"discountPrice\": 649\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu/{{menuItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "{{menuItemId}}"]
            }
          }
        },
        {
          "name": "Toggle Menu Item Availability",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu/{{menuItemId}}/availability",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "{{menuItemId}}", "availability"]
            }
          }
        },
        {
          "name": "Delete Menu Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/menu/{{menuItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["menu", "{{menuItemId}}"]
            }
          }
        }
      ]
    },
    {
