              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Desserts & Shakes\",\n  \"description\": \"Creamy gourmet sweet treats\",\n  \"sortOrder\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["restaurants", "{{restaurantId}}", "categories"]
